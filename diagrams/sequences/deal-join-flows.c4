model {
  participationService = service 'Participation Service' {
    description 'Join/leave, referral links; defers all capacity decisions to Deal Service'
  }
  dealService = service 'Deal Service' {
    description 'Single arbiter of deal state: current_participants, authorized_count, timer'
  }
}

views {

  dynamic view dealJoinAuthorized {
    title 'Deal Join 1 — Payment Authorized Within Timeout'

    client -> participationService 'POST /deals/{dealId}/join  (header X-User-Id)  { referralCode, paymentMethodId, address }'

    participationService -> dealService 'GET /deals/{dealId}  (sync)' {
      notes 'Fetches productId + dealPrice BEFORE the reserve call, so the join payload below can be built without a second round trip.'
    }
    dealService -> participationService '{ id, productId, status, minParticipants, dealStock, currentParticipants, dealPrice, endTime }'

    participationService -> dealService 'POST /internal/deals/{dealId}/reserve-slot  (header requestId = fresh random UUID)  (sync)' {
      notes '
        Two guarded paths inside Deal Service depending on current state:
        first-join (PENDING -> ACTIVE, sets start_time/end_time) via
        reserveSlotFirstJoin, or subsequent-join (already ACTIVE) via
        reserveSlotActive. Both are plain guarded UPDATEs, deduped against
        the deal_slot_requests table by requestId. Success/rejection is
        communicated via a SlotResponse{success, reason, ...} body.
      '
    }
    dealService -> participationService '200 OK  { success: true, dealPrice, currentParticipants, authorizedCount, dealStock, status, startTime, endTime }'

    participationService -> participationService 'insert participations row  (status = ACTIVE)'
    participationService -> kafka 'publish Participant.Joined  (async)' {
      notes 'Event payload: { participantId, dealId, userId, productId, price, paymentMethodId, address, joinedAt }'
    }
    participationService -> client '201 Created  { id, dealId, userId, referredBy, status: ACTIVE, joinedAt, leftAt: null }' {
      notes 'Not 202 — join is synchronous end to end from the buyer perspective; the reservation itself (above) already happened before this response is built.'
    }

    kafka -> orderService 'Participant.Joined'
    orderService -> catalogService 'POST /products/lookup  { productIds: [productId] }  (sync, best-effort)' {
      notes '
        Unlike NORMAL checkout, a Catalog failure here is caught and
        logged, not fatal — the join proceeds with seller_id/productName/
        productImageUrl left null on the line item rather than aborting.
      '
    }
    catalogService -> orderService '{ found: { productId: {id, sellerId, name, imageUrl, basePrice} } }'
    orderService -> paymentService 'GET /api/payment-methods/{paymentMethodId}  (header X-User-Id)  (sync)' {
      notes 'Failure here IS fatal — aborts the whole handler, no order row is created, and the inbound Kafka message is redelivered.'
    }
    paymentService -> orderService '{ cardLast4, cardBrand, cardExpMonth, cardExpYear, ... }'
    orderService -> orderService 'create order (status=PENDING_AUTHORIZATION, card snapshot + seller_id + address from the event) + order_products' {
      notes 'Dedup via processed_events + uq_orders_deal_participant unique index. address has no fallback — orders.address is NOT NULL since V15, so a Participant.Joined without an address would fail this insert.'
    }

    orderService -> kafka 'publish Payment.InitRequired.Authorize  (topic order.payments_requested)' {
      notes 'Event payload: { userId, orderId, amount, paymentMethodId }'
    }
    kafka -> paymentService 'Payment.InitRequired.Authorize'
    paymentService -> stripe 'create + confirm PaymentIntent  (capture_method: manual)'
    stripe -> paymentService 'succeeded'
    paymentService -> kafka 'publish Payment.Authorized  (topic payment.events)' {
      notes 'Event payload: { paymentId, orderId, amount }'
    }
    kafka -> orderService 'Payment.Authorized'
    orderService -> orderService 'UPDATE status = AUTHORIZED, payment_id  WHERE status = PENDING_AUTHORIZATION  (guard)'
    orderService -> dealService 'POST /internal/deals/{dealId}/authorize-slot  (header requestId = UUID.nameUUIDFromBytes("authorize-slot:"+orderId), deterministic)  (sync)'
    dealService -> orderService '200 OK  { success: true, authorizedCount, ... }' {
      notes 'If authorized_count now equals current_participants, DealService.authorizeSlot flips the deal to SUCCEEDED in the same transaction and writes a Deal.Succeeded outbox row (see Deal Join 6).'
    }
    orderService -> kafka 'publish Order.Authorized  (topic order.lifecycle_events)' {
      notes 'Event payload: { orderId, dealId, userId, totalPrice }'
    }

    kafka -> notificationService 'Order.Authorized   → buyer notified: join authorized (email)' {
      notes 'Notification Service sends transactional email (Thymeleaf + EmailSender), not a WebSocket push.'
    }

    include
      client,
      participationService,
      dealService,
      orderService,
      paymentService,
      stripe,
      kafka,
      notificationService
  }

  dynamic view dealJoinDeclined {
    title 'Deal Join 2 — Payment Declined (Async)'

    client -> participationService 'POST /deals/{dealId}/join  { referralCode, paymentMethodId, address }'
    participationService -> dealService 'GET /deals/{dealId}  (sync)'
    dealService -> participationService '{ productId, dealPrice, ... }'
    participationService -> dealService 'POST /internal/deals/{dealId}/reserve-slot  (sync)'
    dealService -> participationService '200 OK  { success: true, ... }'
    participationService -> participationService 'insert participations row  (status = ACTIVE)'
    participationService -> kafka 'publish Participant.Joined  (async)' {
      notes 'Event payload: { participantId, dealId, userId, productId, price, paymentMethodId, address, joinedAt }'
    }
    participationService -> client '201 Created  { id, dealId, userId, status: ACTIVE, ... }'

    kafka -> orderService 'Participant.Joined'
    orderService -> catalogService 'POST /products/lookup  (best-effort)'
    catalogService -> orderService '{ found: { productId: {...} } }'
    orderService -> paymentService 'GET /api/payment-methods/{paymentMethodId}  (sync)'
    paymentService -> orderService '{ cardLast4, cardBrand, ... }'
    orderService -> orderService 'create order  (status=PENDING_AUTHORIZATION) + order_products'

    orderService -> kafka 'publish Payment.InitRequired.Authorize  (topic order.payments_requested)' {
      notes 'Event payload: { userId, orderId, amount, paymentMethodId }'
    }
    kafka -> paymentService 'Payment.InitRequired.Authorize'
    paymentService -> stripe 'create + confirm PaymentIntent  (capture_method: manual)'
    stripe -> paymentService 'card_declined  (Stripe test decline card)'
    paymentService -> kafka 'publish Payment.Failed  (topic payment.events)' {
      notes 'Event payload: { paymentId, orderId, amount, errorMessage, errorCode: card_declined }'
    }
    kafka -> orderService 'Payment.Failed'

    orderService -> orderService 'UPDATE status = CANCELLED, cancel_reason = PAYMENT_DECLINED, payment_id, payment_error_code, payment_error_message  WHERE status = PENDING_AUTHORIZATION  (guard)'
    orderService -> dealService 'POST /internal/deals/{dealId}/release-slot  (header requestId, deterministic)  (sync)' {
      notes 'The order never reached AUTHORIZED, so authorized_count is untouched — only current_participants decrements.'
    }
    dealService -> orderService '200 OK  { success: true, currentParticipants, ... }'

    orderService -> kafka 'publish Order.DealCancelled  (topic order.lifecycle_events)' {
      notes 'Event payload: { orderId, dealId, participantId, userId, reason: PAYMENT_DECLINED, items, totalPrice }'
    }
    kafka -> notificationService 'Order.DealCancelled   → buyer notified: deal order cancelled (email)'

    kafka -> participationService 'Order.DealCancelled'
    participationService -> participationService 'flip row to status = DECLINED'

    include
      client,
      participationService,
      dealService,
      orderService,
      paymentService,
      stripe,
      kafka,
      notificationService
  }

  dynamic view dealJoinRejectedInactive {
    title 'Deal Join 3 — Rejected, Deal Already Resolved'

    client -> participationService 'POST /deals/{dealId}/join  { referralCode, paymentMethodId, address }'
    participationService -> dealService 'GET /deals/{dealId}  (sync)'
    dealService -> participationService '{ status: SUCCEEDED | FAILED | CANCELLED, ... }'

    participationService -> dealService 'POST /internal/deals/{dealId}/reserve-slot  (sync)' {
      notes 'DealService.reserveSlot: deal status is neither PENDING nor ACTIVE, so both guarded paths reject with reason DEAL_NOT_ACTIVE_<status>.'
    }
    dealService -> participationService '{ success: false, dealId, reason: "DEAL_NOT_ACTIVE_SUCCEEDED" }' {
      notes 'Rejection is signalled via the response body, not an error HTTP status.'
    }

    participationService -> client '409 Conflict  { reason: DEAL_NOT_JOINABLE }' {
      notes '
        End of flow — nothing was written anywhere (no participations row,
        no order, no payment call), so no compensation is needed.
      '
    }

    include
      client,
      participationService,
      dealService
  }

  dynamic view dealJoinNoOutcomeSweep {
    title 'Deal Join 4 — No Payment Outcome, Force-Cancelled by Sweep'

    client -> participationService 'POST /deals/{dealId}/join  { referralCode, paymentMethodId, address }'
    participationService -> dealService 'GET /deals/{dealId}  (sync)'
    dealService -> participationService '{ productId, dealPrice, ... }'
    participationService -> dealService 'POST /internal/deals/{dealId}/reserve-slot  (sync)'
    dealService -> participationService '200 OK  { success: true, ... }'
    participationService -> participationService 'insert participations row  (status = ACTIVE)'
    participationService -> kafka 'publish Participant.Joined  (async)' {
      notes 'Event payload: { participantId, dealId, userId, productId, price, paymentMethodId, address, joinedAt }'
    }
    participationService -> client '201 Created  { id, dealId, userId, status: ACTIVE, ... }'

    kafka -> orderService 'Participant.Joined'
    orderService -> catalogService 'POST /products/lookup  (best-effort)'
    catalogService -> orderService '{ found: { productId: {...} } }'
    orderService -> paymentService 'GET /api/payment-methods/{paymentMethodId}  (sync)'
    paymentService -> orderService '{ cardLast4, cardBrand, ... }'
    orderService -> orderService 'create order  (status=PENDING_AUTHORIZATION) + order_products'

    orderService -> kafka 'publish Payment.InitRequired.Authorize  (topic order.payments_requested)'

    kafka -> paymentService 'Payment.InitRequired.Authorize  — never produces an outcome event' {
      notes '
        Covers every silent-failure mode at once: consumer down, event
        never delivered, Stripe down / hanging, or the outcome event
        itself lost. From Order Service side these are indistinguishable:
        it simply never receives Payment.Authorized or Payment.Failed.
      '
    }

    orderService -> orderService 'DealOrderPaymentSweeper  (polls every 60s)' {
      notes '
        Finds orders in status=PENDING_AUTHORIZATION older than 120s / 2min
        (sweeper.deal-order.payment.stale-after) — NOT the same number as
        the 60s poll interval; those are two different config values, easy
        to conflate. No sync call to Payment Service is made here — silence
        past the threshold is itself the failure signal. Runs under every
        Spring profile (no @Profile restriction, unlike
        NormalOrderReservationSweeper in the normal-order flows).
      '
    }
    orderService -> orderService 'UPDATE status = CANCELLED, cancel_reason = PAYMENT_TIMEOUT  WHERE status = PENDING_AUTHORIZATION  (guard)' {
      notes 'The guard makes the sweep and a late Payment.Authorized mutually exclusive (see Deal Join 5)'
    }
    orderService -> dealService 'POST /internal/deals/{dealId}/release-slot  (sync)'
    dealService -> orderService '200 OK  { success: true, currentParticipants, ... }'

    orderService -> kafka 'publish Order.DealCancelled  (topic order.lifecycle_events)' {
      notes 'Event payload: { orderId, dealId, participantId, userId, reason: PAYMENT_TIMEOUT, items, totalPrice }'
    }

    orderService -> kafka 'publish Payment.Timeout  (topic order.payments_requested)' {
      notes 'Event payload: { orderId }'
    }


    kafka -> paymentService 'Payment.Timeout' {
      notes '
        Safety net: if a payment for this orderId is PENDING/REQUIRES_ACTION,
        it is failed; if AUTHORIZED (the authorize actually went through but
        Payment.Authorized was lost), the held funds are voided instead.
        This is what makes force-cancel safe without Order Service ever
        querying Payment Service directly.
      '
    }
    kafka -> notificationService 'Order.DealCancelled   → buyer notified: deal order cancelled (email)'

    kafka -> participationService 'Order.DealCancelled'
    participationService -> participationService 'flip row to status = DECLINED'

    include
      client,
      participationService,
      dealService,
      orderService,
      paymentService,
      kafka,
      notificationService
  }

  dynamic view dealJoinLateAuthorizedAfterSweep {
    title 'Deal Join 5 — Payment.Authorized Arrives After Sweep Force-Cancel (Void)'

    client -> participationService 'POST /deals/{dealId}/join  { referralCode, paymentMethodId, address }'
    participationService -> dealService 'GET /deals/{dealId}  (sync)'
    dealService -> participationService '{ productId, dealPrice, ... }'
    participationService -> dealService 'POST /internal/deals/{dealId}/reserve-slot  (sync)'
    dealService -> participationService '200 OK  { success: true, ... }'
    participationService -> participationService 'insert participations row  (status = ACTIVE)'
    participationService -> kafka 'publish Participant.Joined  (async)'
    participationService -> client '201 Created  { id, dealId, userId, status: ACTIVE, ... }'

    kafka -> orderService 'Participant.Joined'
    orderService -> catalogService 'POST /products/lookup  (best-effort)'
    catalogService -> orderService '{ found: { productId: {...} } }'
    orderService -> paymentService 'GET /api/payment-methods/{paymentMethodId}  (sync)'
    paymentService -> orderService '{ cardLast4, cardBrand, ... }'
    orderService -> orderService 'create order  (status=PENDING_AUTHORIZATION) + order_products'
    orderService -> kafka 'publish Payment.InitRequired.Authorize  (topic order.payments_requested)'

    kafka -> paymentService 'Payment.InitRequired.Authorize'
    paymentService -> stripe 'create + confirm PaymentIntent  (capture_method: manual)  (or Stripe is slow to respond)'

    orderService -> orderService 'DealOrderPaymentSweeper: PENDING_AUTHORIZATION > 120s (2min) -> force-cancel' {
      notes 'Same sweeper as Deal Join 4 - it cannot tell "slow" from "dead"'
    }
    orderService -> orderService 'UPDATE status = CANCELLED, cancel_reason = PAYMENT_TIMEOUT  WHERE status = PENDING_AUTHORIZATION  (guard)'
    orderService -> dealService 'POST /internal/deals/{dealId}/release-slot  (sync)'
    dealService -> orderService '200 OK  { success: true, ... }'
    orderService -> kafka 'publish Order.DealCancelled  (topic order.lifecycle_events)'
    orderService -> kafka 'publish Payment.Timeout  (topic order.payments_requested)' {
      notes 'Event payload: { orderId }'
    }
    kafka -> notificationService 'Order.DealCancelled   → buyer notified: deal order cancelled (email)'
    kafka -> participationService 'Order.DealCancelled'
    participationService -> participationService 'flip row to status = DECLINED'

    stripe -> paymentService 'succeeded  (late)'
    paymentService -> kafka 'publish Payment.Authorized  (topic payment.events)' {
      notes 'Event payload: { paymentId, orderId, amount }'
    }
    kafka -> orderService 'Payment.Authorized  (async, after the cancel already committed)'
    orderService -> orderService 'UPDATE status = AUTHORIZED WHERE status = PENDING_AUTHORIZATION -> 0 rows  - order already cancelled, event ignored' {
      notes '
        The status guard is the whole conflict-resolution mechanism - the
        slot was already released (possibly to another participant) and
        the order is never resurrected. The hold is voided below instead.
      '
    }

    kafka -> paymentService 'Payment.Timeout' {
      notes 'Same handler as Deal Join 4 — a payment that reached AUTHORIZED by the time this arrives has its hold voided via Stripe PaymentIntent cancellation.'
    }
    paymentService -> stripe 'cancel PaymentIntent  (hold exists for a cancelled order)'
    stripe -> paymentService 'canceled'
    paymentService -> kafka 'publish Payment.Voided  (topic payment.events)' {
      notes 'Event payload: { paymentId, orderId, amount }'
    }

    include
      client,
      participationService,
      dealService,
      orderService,
      paymentService,
      stripe,
      kafka,
      notificationService
  }

  dynamic view dealSucceeded {
    title 'Deal Join 6 — Deal Succeeded (Last Authorization Fills Capacity)'

    kafka -> orderService 'Payment.Authorized  (the last remaining participant)' {
      notes 'Abbreviated - full sequence (Payment.InitRequired.Authorize -> ... -> Order.Authorized) is identical to Deal Join 1'
    }
    orderService -> orderService 'UPDATE status = AUTHORIZED, payment_id  WHERE status = PENDING_AUTHORIZATION  (guard)'
    orderService -> dealService 'POST /internal/deals/{dealId}/authorize-slot  (sync, as in Deal Join 1)'
    dealService -> dealService 'authorized_count++  (DealService.authorizeSlot, guarded UPDATE); if this now equals current_participants, succeedIfFullyAuthorized flips status -> SUCCEEDED in the same transaction'
    dealService -> orderService '200 OK  { success: true, authorizedCount, status: SUCCEEDED, ... }'
    orderService -> kafka 'publish Order.Authorized  (topic order.lifecycle_events)' {
      notes 'Event payload: { orderId, dealId, userId, totalPrice } - consumed by Notification Service only, as in Deal Join 1'
    }

    dealService -> dealService 'write deal_outbox row  eventType = "Deal.Succeeded"'
    dealService -> kafka 'OutboxRelayService publishes to topic "deal-events"  (polls every 2s, keyed by dealId for per-deal ordering)' {
      notes 'Event payload: { dealId, authorizedCount, dealStock }'
    }

    kafka -> orderService 'Deal.Succeeded' {
      notes 'DealTopicConsumer does an exact-string switch on the X-Type header against EventTypes.DEAL_SUCCEEDED = "Deal.Succeeded".'
    }
    orderService -> orderService 'batch: SELECT orders WHERE deal_id = ? AND status = AUTHORIZED  FOR UPDATE SKIP LOCKED  -> guarded UPDATE per order -> status = PENDING_CAPTURE' {
      notes 'Resumable, paginated - never one giant all-or-nothing transaction'
    }

    orderService -> kafka 'publish Payment.SettlementRequired.Capture  (topic order.payments_requested, async, per order in the batch)' {
      notes 'Event payload: { orderId, paymentId }'
    }
    kafka -> paymentService 'Payment.SettlementRequired.Capture'
    paymentService -> stripe 'capture PaymentIntent'
    stripe -> paymentService 'succeeded'
    paymentService -> kafka 'publish Payment.Captured  (topic payment.events)' {
      notes 'Event payload: { paymentId, orderId, amount }'
    }
    kafka -> orderService 'Payment.Captured' {
      notes '
        Repeated for every order in the batch, isolated per order.
        Capture failures are not modeled - the design is optimistic on
        this path: a hold captured within its validity window is assumed
        to succeed.
      '
    }
    orderService -> orderService 'UPDATE status = CONFIRMED  WHERE status = PENDING_CAPTURE  (guard, per order); initialize shipping_status = PROCESSING'
    orderService -> kafka 'publish Order.Created  (topic order.lifecycle_events, async, per order)' {
      notes 'Event payload: { orderId, userId, items, totalPrice, address }'
    }

    kafka -> notificationService 'Order.Created   → buyer notified: order confirmed (email, per order)'

    kafka -> inventoryService 'Deal.Succeeded '
    inventoryService -> inventoryService 'UPDATE inventory SET deal_stock = deal_stock - {dealStock}, stock = stock - {authorizedCount}  WHERE product_id = ?'

    include
      client,
      dealService,
      orderService,
      inventoryService,
      paymentService,
      stripe,
      kafka,
      notificationService
  }

  dynamic view dealFailed {
    title 'Deal Join 7 — Deal Failed (Timer Expires Below Minimum)'

    dealService -> dealService 'DealResolutionScheduler  (polls every 5s, not an internal per-deal timer)' {
      notes '
        DealResolutionScheduler.resolveExpiredDeals runs on a fixed
        5-second schedule and calls DealService.resolveExpiredDeals, which
        finds every ACTIVE deal whose end_time has passed
        (findExpiredActiveDeals) and resolves each individually.
      '
    }
    dealService -> dealService 'authorizedCount < minParticipants -> guarded UPDATE status = ACTIVE -> FAILED  (resolveExpiredAsFailed)'
    dealService -> dealService 'write deal_outbox row  eventType = "Deal.Failed"'
    dealService -> kafka 'OutboxRelayService publishes to topic "deal-events"' {
      notes 'Event payload: { dealId, authorizedCount, dealStock }'
    }

    kafka -> orderService 'Deal.Failed'
    orderService -> orderService 'batch: SELECT orders WHERE deal_id = ? AND status = AUTHORIZED  FOR UPDATE SKIP LOCKED  -> guarded UPDATE per order -> status = PENDING_VOID, cancel_reason = DEAL_FAILED' {
      notes 'cancel_reason is set here, at parking time - Payment.Voided has no field to tell this path apart from a participant-leave void'
    }

    orderService -> kafka 'publish Payment.SettlementRequired.Void  (topic order.payments_requested, async, per order in the batch)' {
      notes 'Event payload: { orderId, paymentId }'
    }
    kafka -> paymentService 'Payment.SettlementRequired.Void'
    paymentService -> stripe 'cancel PaymentIntent'
    stripe -> paymentService 'canceled'
    paymentService -> kafka 'publish Payment.Voided  (topic payment.events)' {
      notes 'Event payload: { paymentId, orderId, amount }'
    }
    kafka -> orderService 'Payment.Voided' {
      notes 'Repeated for every authorized order in the batch'
    }
    orderService -> orderService 'UPDATE status = CANCELLED  WHERE status = PENDING_VOID  (guard, per order)' {
      notes 'cancel_reason already set when the order was parked into PENDING_VOID above'
    }
    orderService -> kafka 'publish Order.DealCancelled  (topic order.lifecycle_events, async, per order)' {
      notes 'Event payload: { orderId, dealId, participantId, userId, reason: DEAL_FAILED, items, totalPrice }'
    }

    kafka -> notificationService 'Order.DealCancelled   → buyer notified: deal order cancelled (email, per order)'

    kafka -> inventoryService 'Deal.Failed '
    inventoryService -> inventoryService 'UPDATE inventory SET deal_stock = deal_stock - {dealStock}  WHERE product_id = ?'

    include
      client,
      dealService,
      orderService,
      inventoryService,
      paymentService,
      stripe,
      kafka,
      notificationService
  }

  dynamic view dealParticipantLeave {
    title 'Deal Join 8 — Participant Leaves While Deal Is Running (>10 min Remaining)'

    client -> participationService 'DELETE /deals/{dealId}/leave  (header X-User-Id)'

    participationService -> dealService 'GET /internal/deals/{dealId}/check-leave-eligible  (sync)' {
      notes '
        Read-only, no requestId header (unlike the mutating slot
        endpoints). DealService.checkLeaveEligible: rejects unless
        status = ACTIVE AND now < end_time - 10 minutes
        (deal.getEndTime().minusMinutes(10).isBefore(now) == false).
        Sync because the buyer is waiting on this response.

        Unlike reserve-slot (Deal Join 3), the Participation Service client
        DOES correctly parse this response body (bodyToMono, not
        toBodilessEntity) and throws LeaveNotEligibleException when
        eligible=false — this rejection path genuinely works.
      '
    }
    dealService -> participationService '{ eligible: true }'

    participationService -> participationService 'flip row to status = LEFT'
    participationService -> kafka 'publish Participant.Left  (async)' {
      notes 'Event payload: { participantId, dealId }'
    }
    participationService -> client '204 No Content' {
      notes 'Not 202 — the leave call is synchronous end to end; DELETE returns no body.'
    }

    kafka -> orderService 'Participant.Left'
    orderService -> orderService 'find order  WHERE deal_id = ? AND participant_id = ?  (status = AUTHORIZED)'
    orderService -> orderService 'UPDATE status = PENDING_VOID, cancel_reason = PARTICIPANT_LEFT  WHERE status = AUTHORIZED  (guard)' {
      notes '
        Parks the order in PENDING_VOID before the void is fired - the
        same intermediate state the deal-failed batch uses (see Deal Join
        7), so a concurrent Deal.Succeeded/Deal.Failed batch over this
        deal_id can no longer race this order
        (the batch selects WHERE status = AUTHORIZED and skips it).
        cancel_reason is set here, at parking time, since Payment.Voided
        later has no field to tell this path apart from a deal-failed void.
      '
    }

    orderService -> kafka 'publish Payment.SettlementRequired.Void  (topic order.payments_requested, async)' {
      notes 'Event payload: { orderId, paymentId }'
    }
    kafka -> paymentService 'Payment.SettlementRequired.Void'
    paymentService -> stripe 'cancel PaymentIntent  (release the hold)'
    stripe -> paymentService 'canceled'
    paymentService -> kafka 'publish Payment.Voided  (topic payment.events)' {
      notes 'Event payload: { paymentId, orderId, amount }'
    }
    kafka -> orderService 'Payment.Voided'

    orderService -> orderService 'UPDATE status = CANCELLED  WHERE status = PENDING_VOID  (guard)' {
      notes 'cancel_reason already set when the order was parked into PENDING_VOID above'
    }
    orderService -> dealService 'POST /internal/deals/{dealId}/release-authorized-slot  (header requestId, deterministic)  (sync, guarded WHERE status = ACTIVE)' {
      notes 'Distinct endpoint from release-slot - this order had reached AUTHORIZED (hold was placed), so both counters must be undone atomically: current_participants-- and authorized_count--.'
    }
    dealService -> orderService '200 OK  { success: true, currentParticipants, authorizedCount, ... }'

    orderService -> kafka 'publish Order.DealCancelled  (topic order.lifecycle_events, async)' {
      notes 'Event payload: { orderId, dealId, participantId, userId, reason: PARTICIPANT_LEFT, items, totalPrice }'
    }

    kafka -> notificationService 'Order.DealCancelled   → buyer notified: deal order cancelled (email)'

    include
      client,
      participationService,
      dealService,
      orderService,
      paymentService,
      stripe,
      kafka,
      notificationService
  }

}
