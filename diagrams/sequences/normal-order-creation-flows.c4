specification {
  element actor {
    style { shape person }
  }
  element service
  element external
  element queue
}

model {
  client = actor 'Buyer / Client'

  orderService = service 'Order Service' {
    description 'Owns orders for both deal and normal purchases; only caller of Payment Service'
  }
  catalogService = service 'Catalog Service'
  inventoryService = service 'Inventory Service'
  paymentService = service 'Payment Service' {
    description 'Deal-blind ledger; backed by Stripe (test mode)'
  }
  stripe = external 'Stripe (test mode)'
  notificationService = service 'Notification Service' {
    description 'Sends transactional email (Thymeleaf templates via EmailSender) — not a WebSocket push'
  }
  kafka = queue 'Kafka'
}

views {

  dynamic view orderCreationHappyPath {
    title 'Order Creation — Happy Path'

    client -> orderService 'POST /api/orders/checkout  (header X-User-Id)  { orderItems[], paymentMethodId, address }' {
      notes 'Buyer id travels as a header, never a body field or path segment.'
    }

    orderService -> catalogService 'POST /products/lookup  { productIds }  (sync)' {
      notes '
        Fetches authoritative basePrice + sellerId per product.
        Client-supplied price is never trusted. sellerId is stored on
        order_products.seller_id for the seller-facing order surface.
        Any notFound fails with 404 here, before any order row exists.
      '
    }
    catalogService -> orderService '{ found: { productId: {id, sellerId, name, imageUrl, basePrice} }, notFound }'

    orderService -> paymentService 'GET /api/payment-methods/{paymentMethodId}  (header X-User-Id)  (sync)' {
      notes '
        One-time card-snapshot fetch, at order-creation time only. Order
        Service stores cardLast4/cardBrand/cardExpMonth/cardExpYear on the
        order row and never sees a Stripe paymentIntentId — Payment Service
        owns any PaymentIntent <-> paymentMethodId mapping internally.
      '
    }
    paymentService -> orderService '{ cardLast4, cardBrand, cardExpMonth, cardExpYear, ... }'

    orderService -> orderService 'create order (status=RESERVING, card snapshot + address + seller_id per line item) + order_products rows' {
      notes '
        Order row is durable BEFORE reservation is attempted — this is what
        gives order-reserve a real orderId to key against, and what lets
        the reconciliation sweep recover a crash mid-request.
      '
    }

    orderService -> inventoryService 'POST /order-reserve  { orderId, items: [{productId, quantity}, ...] }  (sync, ONE batch call for the whole cart)' {
      notes '
        Not one call per product — a single request covering every line
        item. Inventory Service checks availability for every item first
        and only commits reservations if ALL are available (a pure
        precheck, not reserve-then-rollback) — verified in
        InventoryServiceImpl.reserveOrder: nothing is written to
        reserved_stock/available_stock unless every item passes.
      '
    }
    inventoryService -> orderService '{ orderId, items: [{productId, available, reserved: true}, ...] }  — all reserved=true'

    orderService -> orderService 'status = PENDING_CHARGE'

    orderService -> kafka 'publish Payment.InitRequired.Charge  (topic order.payments_requested)' {
      notes 'Event payload: { userId, orderId, amount, paymentMethodId }'
    }

    orderService -> client '202 Accepted  { id, status: PENDING_CHARGE, cancelReason: null, totalPrice, orderProducts, createdAt }' {
      notes '
        The checkout endpoint ALWAYS returns 202 — never 201, never 402,
        never 409. It reflects only the synchronous outcome of catalog
        lookup + card-snapshot fetch + order creation + reservation, and
        never waits on Payment Service or Stripe. The buyer learns the
        final outcome via email or by polling GET /api/orders/{id}.
      '
    }

    kafka -> paymentService 'Payment.InitRequired.Charge'
    paymentService -> stripe 'create + confirm PaymentIntent  (capture_method: automatic)'
    stripe -> paymentService 'succeeded'
    paymentService -> kafka 'publish Payment.Charged  (topic payment.events)' {
      notes 'Event payload: { paymentId, orderId, amount }'
    }
    kafka -> orderService 'Payment.Charged'

    orderService -> orderService 'UPDATE status = CONFIRMED, payment_id  WHERE status = PENDING_CHARGE  (guard); initialize shipping_status = PROCESSING' {
      notes 'Guard keeps this a no-op if the sweep force-cancelled first'
    }
    orderService -> kafka 'publish Order.Created  (topic order.lifecycle_events)' {
      notes '
        Event payload: { orderId, userId, items, totalPrice, address }
      '
    }
    kafka -> notificationService 'Order.Created   → buyer notified: order confirmed (email)'

    include
      client,
      orderService,
      catalogService,
      inventoryService,
      paymentService,
      stripe,
      kafka,
      notificationService
  }

  dynamic view orderCreationCatalogUnreachable {
    title 'Order Creation — Catalog Service Unreachable'

    client -> orderService 'POST /api/orders/checkout  (header X-User-Id)  { orderItems[], paymentMethodId, address }'

    orderService -> catalogService 'POST /products/lookup  { productIds }  (sync)' {
      notes 'Connection fails / times out — Catalog Service unreachable'
    }

    orderService -> orderService 'no order row created' {
      notes '
        This fails before the durable order row is written, so there is
        nothing for the reconciliation sweep to clean up and no
        compensating event to publish — Inventory and Payment were never
        touched.
      '
    }

    orderService -> client '503 Service Unavailable'

    include
      client,
      orderService,
      catalogService
  }

  dynamic view orderCreationProductNotFound {
    title 'Order Creation — Product Not Found in Catalog'

    client -> orderService 'POST /api/orders/checkout  (header X-User-Id)  { orderItems: [{productId: 1}, {productId: 2}], ... }'

    orderService -> catalogService 'POST /products/lookup  { productIds: [1, 2] }  (sync)'
    catalogService -> orderService '{ found: {1: {...}}, notFound: [2] }' {
      notes 'Product 2 does not exist (or is not currently sellable) in Catalog'
    }

    orderService -> orderService 'no order row created' {
      notes '
        Rejected before persistence, same as the unreachable case — the
        client-facing contract is "fail fast, before touching Payment or
        Inventory" for any Catalog-stage problem, known or unknown product.
      '
    }

    orderService -> client '404 Not Found  { error: "..." }' {
      notes 'ProductNotFoundException on the first missing productId — not a 400'
    }

    include
      client,
      orderService,
      catalogService
  }

  dynamic view orderCreationInsufficientStock {
    title 'Order Creation — Insufficient Stock Mid-Cart'

    client -> orderService 'POST /api/orders/checkout  (2 items)'
    orderService -> catalogService 'POST /products/lookup'
    catalogService -> orderService '{ found, notFound }'
    orderService -> paymentService 'GET /api/payment-methods/{paymentMethodId}  (header X-User-Id)  (sync)'
    paymentService -> orderService '{ cardLast4, cardBrand, ... }'

    orderService -> orderService 'create order (status=RESERVING) + order_products rows'

    orderService -> inventoryService 'POST /order-reserve  { orderId, items: [{1,qty},{2,qty}] }  (single batch call)' {
      notes '
        Inventory Service checks BOTH items before committing anything.
        Product 2 does not have enough available_stock, so
        InventoryServiceImpl.reserveOrder never touches reserved_stock for
        EITHER item — it is a pure precheck, not a partial reserve that
        gets rolled back.
      '
    }
    inventoryService -> orderService '{ orderId, items: [{1, available: 10, reserved: true}, {2, available: 0, reserved: false}] }' {
      notes 'reserved flags are diagnostic only — nothing was actually reserved for item 1 either, since the batch never committed'
    }

    orderService -> orderService 'status = CANCELLED, cancel_reason = INSUFFICIENT_STOCK' {
      notes '
        No synchronous release call is needed or made — nothing was
        reserved to begin with. Order Service only updates the row and
        publishes.
      '
    }
    orderService -> kafka 'publish Order.NormalCancelled  (topic order.lifecycle_events)' {
      notes 'Event payload: { orderId, userId, cancelReason, items: [1, 2], totalPrice, paymentErrorMessage: null }'
    }

    orderService -> client '202 Accepted  { id, status: CANCELLED, cancelReason: INSUFFICIENT_STOCK, ... }' {
      notes 'Never a distinct 409 — the checkout endpoint always returns 202 (see the happy-path view)'
    }

    kafka -> inventoryService 'Order.NormalCancelled '
    inventoryService -> inventoryService 'no-op — the batch reservation never committed, nothing to release'
    kafka -> notificationService 'Order.NormalCancelled   → buyer notified: order cancelled'

    include
      client,
      orderService,
      catalogService,
      inventoryService,
      paymentService,
      kafka,
      notificationService
  }

  dynamic view orderCreationInventoryUnreachable {
    title 'Order Creation — Inventory Service Unreachable'

    client -> orderService 'POST /api/orders/checkout  (2 items)'
    orderService -> catalogService 'POST /products/lookup'
    catalogService -> orderService '{ found, notFound }'
    orderService -> paymentService 'GET /api/payment-methods/{paymentMethodId}  (sync)'
    paymentService -> orderService '{ cardLast4, cardBrand, ... }'

    orderService -> orderService 'create order (status=RESERVING) + order_products rows'

    orderService -> inventoryService 'POST /order-reserve  (single batch call, all items)' {
      notes 'Connection fails / times out — Inventory Service unreachable'
    }

    orderService -> orderService 'status = CANCELLED, cancel_reason = INVENTORY_UNREACHABLE' {
      notes '
        No compensating call is attempted (Inventory Service is already
        unreachable — that call would just fail too, and nothing was ever
        reserved). The Order.NormalCancelled publish is durable via the
        outbox regardless.
      '
    }
    orderService -> kafka 'publish Order.NormalCancelled  (topic order.lifecycle_events)' {
      notes 'Event payload: { orderId, userId, cancelReason, items: [1, 2], totalPrice, paymentErrorMessage: null }'
    }

    orderService -> client '202 Accepted  { id, status: CANCELLED, cancelReason: INVENTORY_UNREACHABLE, ... }'

    kafka -> notificationService 'Order.NormalCancelled   → buyer notified: order cancelled'

    include
      client,
      orderService,
      catalogService,
      inventoryService,
      paymentService,
      kafka,
      notificationService
  }

  dynamic view orderCreationPaymentDeclined {
    title 'Order Creation — Payment Declined (Async Fast Path)'

    client -> orderService 'POST /api/orders/checkout'
    orderService -> catalogService 'POST /products/lookup'
    catalogService -> orderService '{ found, notFound }'
    orderService -> paymentService 'GET /api/payment-methods/{paymentMethodId}  (sync)'
    paymentService -> orderService '{ cardLast4, cardBrand, ... }'

    orderService -> orderService 'create order (status=RESERVING) + order_products rows'
    orderService -> inventoryService 'POST /order-reserve  (all items)'
    inventoryService -> orderService 'all reserved=true'
    orderService -> orderService 'status = PENDING_CHARGE'

    orderService -> kafka 'publish Payment.InitRequired.Charge  (topic order.payments_requested)' {
      notes 'Event payload: { userId, orderId, amount, paymentMethodId }'
    }

    orderService -> client '202 Accepted  { id, status: PENDING_CHARGE, ... }' {
      notes '
        The client is never told "declined" on the checkout request — the
        decline happens after the HTTP exchange is already over. The
        buyer finds out via email (when that path works) or by polling
        the order, which will read CANCELLED / PAYMENT_DECLINED.
      '
    }

    kafka -> paymentService 'Payment.InitRequired.Charge'
    paymentService -> stripe 'create + confirm PaymentIntent  (capture_method: automatic)'
    stripe -> paymentService 'card_declined  (Stripe test decline card)'
    paymentService -> kafka 'publish Payment.Failed  (topic payment.events)' {
      notes 'Event payload: { paymentId, orderId, amount, errorMessage, errorCode }. errorCode is a raw Stripe decline code (card_declined, incorrect_cvc, expired_card, processing_error, ...); errorMessage is only populated by Payment Service when errorCode = card_declined.'
    }

    kafka -> orderService 'Payment.Failed'

    orderService -> orderService 'UPDATE status = CANCELLED, cancel_reason = PAYMENT_DECLINED, payment_id, payment_error_code, payment_error_message  WHERE status = PENDING_CHARGE  (guard)'
    orderService -> kafka 'publish Order.NormalCancelled  (topic order.lifecycle_events)' {
      notes 'Event payload: { orderId, userId, cancelReason, items: [1, 2], totalPrice, paymentErrorMessage }'
    }

    kafka -> inventoryService 'Order.NormalCancelled '
    inventoryService -> inventoryService 'release reservation  (all items)'
    kafka -> notificationService 'Order.NormalCancelled   → buyer notified: payment declined'

    include
      client,
      orderService,
      catalogService,
      inventoryService,
      paymentService,
      stripe,
      kafka,
      notificationService
  }

  dynamic view orderCreationPaymentNoOutcome {
    title 'Order Creation — No Payment Outcome, Force-Cancelled by Sweep'

    client -> orderService 'POST /api/orders/checkout'
    orderService -> catalogService 'POST /products/lookup'
    catalogService -> orderService '{ found, notFound }'
    orderService -> paymentService 'GET /api/payment-methods/{paymentMethodId}  (sync)'
    paymentService -> orderService '{ cardLast4, cardBrand, ... }'

    orderService -> orderService 'create order (status=RESERVING) + order_products rows'
    orderService -> inventoryService 'POST /order-reserve  (all items)'
    inventoryService -> orderService 'all reserved=true'
    orderService -> orderService 'status = PENDING_CHARGE'

    orderService -> kafka 'publish Payment.InitRequired.Charge  (topic order.payments_requested)'

    orderService -> client '202 Accepted  { id, status: PENDING_CHARGE }'

    kafka -> paymentService 'Payment.InitRequired.Charge  — never produces an outcome event' {
      notes '
        Covers every silent-failure mode at once: consumer down, event
        never delivered, Stripe down / hanging, or the outcome event
        itself lost. From Order Service side these are indistinguishable:
        it simply never receives Payment.Charged or Payment.Failed.
      '
    }

    orderService -> orderService 'NormalOrderPaymentSweeper  (polls every 2s)' {
      notes '
        Finds orders in status=PENDING_CHARGE older than 300s (5 min) —
        sweeper.normal-order.payment.stale-after in application.properties.
        Deliberately makes NO sync call to Payment Service — that would
        re-introduce the coupling this design removes. Silence past the
        threshold is itself treated as the failure signal. Runs under every
        Spring profile (unlike NormalOrderReservationSweeper below, which
        is @Profile("prod")-only).
      '
    }
    orderService -> orderService 'UPDATE status = CANCELLED, cancel_reason = PAYMENT_TIMEOUT  WHERE status = PENDING_CHARGE  (guard)' {
      notes '
        The guard makes the sweep and a late Payment.Charged mutually
        exclusive — whichever commits first wins, the other becomes a
        no-op (see the late-charge view for the losing side).
      '
    }
    orderService -> kafka 'publish Order.NormalCancelled  (topic order.lifecycle_events)' {
      notes 'Event payload: { orderId, userId, cancelReason, items: [1, 2], totalPrice, paymentErrorMessage: null }'
    }
    orderService -> kafka 'publish Payment.Timeout  (topic order.payments_requested)' {
      notes 'Event payload: { orderId }'
    }


    kafka -> inventoryService 'Order.NormalCancelled   → release stock  (all items)'
    kafka -> paymentService 'Payment.Timeout' {
      notes '
        PENDING/REQUIRES_ACTION payment -> fails it (errorCode "timeout").
        AUTHORIZED payment -> voids/cancels the Stripe PaymentIntent
        instead (see PaymentService.resolveTimeout). This is what makes
        force-cancel safe without Order Service ever querying Payment
        Service directly: if the charge actually went through but
        Payment.Charged was lost, the hold/charge is still undone here.
      '
    }
    kafka -> notificationService 'Order.NormalCancelled   → buyer notified: order cancelled'

    include
      client,
      orderService,
      catalogService,
      inventoryService,
      paymentService,
      kafka,
      notificationService
  }

  dynamic view orderCreationLateChargeAfterSweep {
    title 'Order Creation — Payment.Charged Arrives After Sweep Force-Cancel (void)'

    client -> orderService 'POST /api/orders/checkout'
    orderService -> catalogService 'POST /products/lookup'
    catalogService -> orderService '{ found, notFound }'
    orderService -> paymentService 'GET /api/payment-methods/{paymentMethodId}  (sync)'
    paymentService -> orderService '{ cardLast4, cardBrand, ... }'
    orderService -> orderService 'create order (status=RESERVING) + order_products rows'
    orderService -> inventoryService 'POST /order-reserve  (all items)'
    inventoryService -> orderService 'all reserved=true'
    orderService -> orderService 'status = PENDING_CHARGE'

    orderService -> kafka 'publish Payment.InitRequired.Charge  (topic order.payments_requested)'

    orderService -> client '202 Accepted  { id, status: PENDING_CHARGE }'

    kafka -> paymentService 'Payment.InitRequired.Charge  (delivered very late — consumer lag / restart)'
    paymentService -> stripe 'create + confirm PaymentIntent  (or Stripe is slow to respond)'

    orderService -> orderService 'NormalOrderPaymentSweeper: PENDING_CHARGE > 300s (5 min) -> force-cancel' {
      notes 'Same sweeper as the no-outcome view — it cannot tell "slow" from "dead"'
    }
    orderService -> orderService 'UPDATE status = CANCELLED, cancel_reason = PAYMENT_TIMEOUT  WHERE status = PENDING_CHARGE  (guard)'
    orderService -> kafka 'publish Order.NormalCancelled  (topic order.lifecycle_events)'
    orderService -> kafka 'publish Payment.Timeout  (topic order.payments_requested)' {
      notes 'Event payload: { orderId }'
    }


    kafka -> inventoryService 'Order.NormalCancelled   → release stock  (all items)'
    kafka -> notificationService 'Order.NormalCancelled   → buyer notified: order cancelled'

    stripe -> paymentService 'succeeded  (late)'
    paymentService -> kafka 'publish Payment.Charged  (topic payment.events)' {
      notes 'Event payload: { paymentId, orderId, amount }'
    }
    kafka -> orderService 'Payment.Charged  (async, after the cancel already committed)'
    orderService -> orderService 'UPDATE ... WHERE status = PENDING_CHARGE -> 0 rows  — order already cancelled, event ignored' {
      notes '
        The status guard is the whole conflict-resolution mechanism: the
        order is never resurrected. The buyer was already told
        "cancelled"; the money is returned below instead.
      '
    }

    kafka -> paymentService 'Payment.Timeout' {
      notes '
        Payment is PENDING or newly CHARGED depending on exact timing —
        PaymentService.resolveTimeout only acts on PENDING/REQUIRES_ACTION
        (fail) or AUTHORIZED (void); a payment that already reached
        CHARGED/CAPTURED by the time this arrives is left alone by this
        handler (the "default -> skip" branch), so a genuinely late but
        successful charge is not automatically refunded by this path.
      '
    }

    include
      client,
      orderService,
      catalogService,
      inventoryService,
      paymentService,
      stripe,
      kafka,
      notificationService
  }

  dynamic view orderCreationCrashMidReservation {
    title 'Order Creation — Process Crash Before Reservation Completes (Orphan Recovery)'

    client -> orderService 'POST /api/orders/checkout  (2 items)'
    orderService -> catalogService 'POST /products/lookup'
    catalogService -> orderService '{ found, notFound }'
    orderService -> paymentService 'GET /api/payment-methods/{paymentMethodId}  (sync)'
    paymentService -> orderService '{ cardLast4, cardBrand, ... }'
    orderService -> orderService 'create order (status=RESERVING) + order_products rows'

    orderService -> orderService 'process crashes  (before the order-reserve call returns, before any client response)' {
      notes '
        No response was ever sent to the client for this request — the
        connection simply dropped. Recovery from here is entirely the
        sweep job below; nothing about this path is synchronous.
      '
    }

    orderService -> orderService 'NormalOrderReservationSweeper  (polls every 2s, @Profile("prod") only)' {
      notes '
        Order has been in status=RESERVING for > 20s
        (sweeper.normal-order.reservation.stale-after) — that status
        normally lives only for the duration of one HTTP request (a
        catalog call + a card-snapshot call + one reservation call), so
        persisting past 20s means the process died mid-request. Much
        shorter threshold than PENDING_CHARGE (300s) because there is no
        third party (Stripe) whose latency needs to be waited out. This
        sweeper does NOT run under any Spring profile other than "prod" —
        a crash like this is never auto-recovered under other profiles.
      '
    }
    orderService -> orderService 'UPDATE status = CANCELLED, cancel_reason = RESERVATION_INCOMPLETE  WHERE status = RESERVING  (guard)'
    orderService -> kafka 'publish Order.NormalCancelled  (topic order.lifecycle_events)' {
      notes 'Event payload: { orderId, userId, cancelReason, items: [1, 2], totalPrice, paymentErrorMessage: null }'
    }

    kafka -> inventoryService 'Order.NormalCancelled '
    inventoryService -> inventoryService 'no-op — the order-reserve call itself may never have landed before the crash'
    kafka -> notificationService 'Order.NormalCancelled   → buyer notified: order cancelled'

    include
      client,
      orderService,
      catalogService,
      inventoryService,
      kafka,
      notificationService
  }

}
